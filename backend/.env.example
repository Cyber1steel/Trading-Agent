APP_NAME=Trading Agent API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trading_agent
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_LOCAL_FILES_ONLY=true
HYBRID_SEMANTIC_CANDIDATES=20
HYBRID_LEXICAL_CANDIDATES=20
HYBRID_RRF_K=60
REASONING_PROVIDER_ORDER=groq,openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
REASONING_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
REASONING_OPENAI_BASE_URL=
REASONING_TIMEOUT_SECONDS=30
REASONING_MAX_OUTPUT_TOKENS=1600
REASONING_MAX_INPUT_BYTES=65536
REASONING_EFFORT=medium
